{
  "regions": [
    "yul1"
  ],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' blob: https://*.zoho.com https://*.zohopublic.ca https://*.zohostatic.com https://www.clarity.ms https://scripts.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com https://*.zohostatic.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com https://api.fontshare.com https://cdn.fontshare.com https://*.zohostatic.com; media-src 'self' data: blob:; connect-src 'self' https://*.catalystserverless.ca https://fonts.googleapis.com https://fonts.gstatic.com https://api.fontshare.com https://*.zoho.com https://*.zohopublic.ca https://www.clarity.ms https://*.clarity.ms; frame-src https://*.zoho.com https://forms.zohopublic.ca; form-action 'self' https://*.zoho.com https://forms.zohopublic.ca; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "whollar.ca"
        }
      ],
      "destination": "https://www.whollar.ca/:path*",
      "statusCode": 308
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "whollar.com"
        }
      ],
      "destination": "https://www.whollar.ca/:path*",
      "statusCode": 308
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.whollar.com"
        }
      ],
