node_modules/
.DS_Store
.backup/
.claude/settings.local.json
*.textClipping
.env
# Catalyst build artifacts. .build/ is what `catalyst deploy` stages: 35 MB of
# generated copies of the functions plus their node_modules, regenerated on
# every deploy, and the debug log beside it is one machine's console output.
# Neither is source, and .build/ carries a second, stale copy of every route.
catalyst-backend/**/.output/
catalyst-backend/.build/
catalyst-backend/catalyst-debug.log
.vercel
.env*
# Raw source images (site serves optimized copies from images/resources/)
Resourcesimages/
# SEO report exports (endl.io downloads, not site source)
endl.io_*.csv
# The admin console lives in its own repo (priyanshu3232/admin-console),
# nested here for local convenience only — never commit it into this one.
admin-console/
# Local agent/tooling state, never site source
.claude/
.membrane/
skills-lock.json
custom-skills/

# Zoho Catalyst table exports pulled from the console for a look. These are
# rows, not code: the one that prompted this line was provider_orgs, i.e. real
# partner companies. Never commit one.
catalyst-backend/Export_*.zip

# Local QA screenshots. Working files, not site source, and cleanUrls would
# otherwise serve them verbatim at /private/tmp-shots/.
private/

# Timestamped local backups from in-place edits, never source.
*.bak-*
